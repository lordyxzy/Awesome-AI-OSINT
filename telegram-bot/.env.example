# ====== Required ======
# Get this token from @BotFather in Telegram
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ====== Optional: AI assistant (/ai command) ======
# Any OpenAI-compatible endpoint works (OpenAI, OpenRouter, Groq, local LLM, etc.)
# Leave AI_API_KEY empty to disable the /ai command.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ====== Optional: access control ======
# Comma-separated list of Telegram numeric user IDs allowed to use the bot.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=

# ====== Optional: behaviour ======
# Comma-separated list of platforms to skip in the username search (by key).
USERNAME_SKIP=
# Per-request HTTP timeout in milliseconds.
HTTP_TIMEOUT_MS=10000
